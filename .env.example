# Google Cloud / BigQuery / GCS
PROJECT_ID=your-google-cloud-project-id
GOOGLE_CREDENTIALS={"type":"service_account"}

# OpenAI article research and drafting
OPENAI_API_KEY=your-openai-api-key
MEDIA_AI_MODEL=gpt-5.6-luna
MEDIA_AI_REASONING_EFFORT=low

# ANALYCA Media
NEXT_PUBLIC_MEDIA_URL=https://media.analyca.jp
MEDIA_ADMIN_USER_IDS=comma-separated-analyca-user-ids
# Optional when ADMIN_PASSWORD already exists. OAuth login also creates a signed session for allowed users.
MEDIA_ADMIN_PASSWORD=
# Recommended: random 32+ character value. Falls back to existing OAuth app secrets when omitted.
MEDIA_ADMIN_SESSION_SECRET=
