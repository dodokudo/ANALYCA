# Google Cloud / BigQuery / GCS
PROJECT_ID=your-google-cloud-project-id
GOOGLE_CREDENTIALS={"type":"service_account"}

# Customer receipt issuance. Enable only after storage/Drive/SMTP verification.
RECEIPTS_ENABLED=false
RECEIPTS_BUCKET=
RECEIPTS_SECRET=
RECEIPTS_DRIVE_ROOT_ID=
RECEIPTS_DRIVE_USE_FISCAL_PERIOD=false
# Required only when USE_FISCAL_PERIOD=true (anchor year = fiscal start year).
RECEIPTS_FISCAL_START_MONTH=
RECEIPTS_FISCAL_ANCHOR_YEAR=
RECEIPTS_FISCAL_ANCHOR_PERIOD=
# CRON_SECRET is shared with existing cron endpoints; preserve any configured value.
CRON_SECRET=

# OpenAI article research and drafting
OPENAI_API_KEY=your-openai-api-key
MEDIA_AI_MODEL=gpt-5.6-luna
MEDIA_AI_REASONING_EFFORT=low

# ANALYCA Media
# Public media URL is https://analyca.jp/media (lib/media/site.ts).
MEDIA_ADMIN_USER_IDS=comma-separated-analyca-user-ids
# Optional when ADMIN_PASSWORD already exists. OAuth login also creates a signed session for allowed users.
MEDIA_ADMIN_PASSWORD=
# Recommended: random 32+ character value. Falls back to existing OAuth app secrets when omitted.
MEDIA_ADMIN_SESSION_SECRET=
